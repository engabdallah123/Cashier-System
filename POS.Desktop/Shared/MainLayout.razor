@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject CustomAuthStateProvider AuthState
@inject ShiftStateContainer ShiftState
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    .topbar-btn-price {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: #ffffff !important;
        text-decoration: none;
        padding: 0.45rem 0.95rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
        transition: all 0.2s ease;
        border: 1px solid rgba(255, 255, 255, 0.15);
    }
    .topbar-btn-price:hover {
        transform: translateY(-1.5px);
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.5);
        color: #ffffff !important;
        background: linear-gradient(135deg, #4338ca, #4f46e5);
    }
</style>

<div class="app-container">
    <NavMenu />

    <div class="main-content">
        <header class="top-bar">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <span class="badge @(ShiftState.IsShiftOpen ? "badge-green" : "badge-red")">
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem;"></i>
                    @(ShiftState.IsShiftOpen ? $"الوردية مفتوحة (#{ShiftState.ShiftId.ToString()[..6]})" : "الوردية مغلقة")
                </span>

                <!-- Price Check Top Bar Button -->
                <NavLink href="price-check" class="topbar-btn-price" title="استعلام فوري عن سعر منتج بالباركود">
                    <i class="fa-solid fa-barcode"></i>
                    <span>الاستعلام عن السعر</span>
                </NavLink>
            </div>

            <div style="display: flex; align-items: center; gap: 1rem;">
                <!-- Light / Dark Theme Switcher Button -->
                <button class="btn btn-secondary" style="padding: 0.45rem 0.85rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;" @onclick="ToggleTheme" title="تغيير مظهر البرنامج">
                    <i class="fa-solid @(isDarkMode ? "fa-sun" : "fa-moon")" style="color: @(isDarkMode ? "#f59e0b" : "#6366f1")"></i>
                    <span>@(isDarkMode ? "المظهر الفاتح" : "المظهر الداكن")</span>
                </button>

                <div class="user-profile-badge">
                    <div class="user-avatar">
                        @((AuthState.UserFullName ?? "م")[0])
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">@(AuthState.UserFullName ?? "مستخدم الكاشير")</span>
                        <span style="font-size: 0.72rem; color: var(--accent-blue); font-weight: 600;">@(IsAdminOrManager ? "مدير النظام" : "كاشير")</span>
                    </div>
                </div>

                <button class="btn btn-secondary" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;" @onclick="Logout" title="تسجيل الخروج">
                    <i class="fa-solid fa-right-from-bracket me-1"></i> تسجيل خروج
                </button>
            </div>
        </header>

        <main class="page-body">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isDarkMode = true;

    private bool IsAdminOrManager =>
        string.Equals(AuthState.UserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Administrator", StringComparison.OrdinalIgnoreCase);

    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getAppTheme");
                isDarkMode = theme != "light";
                await JS.InvokeVoidAsync("setAppTheme", isDarkMode ? "dark" : "light");

                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initGlobalNavigationShortcuts", _dotNetRef);

                StateHasChanged();
            }
            catch
            {
                // Fallback if JS call fails during startup
            }
        }
    }

    [JSInvokable]
    public void NavigateFromShortcut(string route)
    {
        Nav.NavigateTo(route);
    }

    protected override void OnInitialized()
    {
        ShiftState.OnShiftStateChanged += StateHasChanged;
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        var themeStr = isDarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("setAppTheme", themeStr);
    }

    private void Logout()
    {
        AuthState.MarkUserAsLoggedOut();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        ShiftState.OnShiftStateChanged -= StateHasChanged;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}

