@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using global::POS.Desktop.Pages
@inject CustomAuthStateProvider AuthState
@inject ShiftStateContainer ShiftState
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    .topbar-btn-price {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: #ffffff !important;
        text-decoration: none;
        padding: 0.45rem 0.95rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
        transition: all 0.2s ease;
        border: 1px solid rgba(255, 255, 255, 0.15);
        cursor: pointer;
    }
    .topbar-btn-price:hover {
        transform: translateY(-1.5px);
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.5);
        color: #ffffff !important;
        background: linear-gradient(135deg, #4338ca, #4f46e5);
    }
</style>

<div class="app-container">
    <NavMenu />

    <div class="main-content">
        <header class="top-bar">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <span class="badge @(ShiftState.IsShiftOpen ? "badge-green" : "badge-red")">
                    <i class="fa-solid fa-circle" style="font-size: 0.5rem;"></i>
                    @(ShiftState.IsShiftOpen ? $"الوردية مفتوحة (#{ShiftState.ShiftId.ToString()[..6]})" : "الوردية مغلقة")
                </span>

                <!-- Price Check Top Bar Button (Opens Window Popup on Top of Page) -->
                <button type="button" class="topbar-btn-price" @onclick='() => OpenQuickWindow("price-check")' title="استعلام فوري عن سعر منتج بالباركود بدون مغادرة الشاشة الحالية">
                    <i class="fa-solid fa-barcode"></i>
                    <span>الاستعلام عن السعر</span>
                </button>
            </div>

            <div style="display: flex; align-items: center; gap: 1rem;">
                <!-- Light / Dark Theme Switcher Button -->
                <button class="btn btn-secondary" style="padding: 0.45rem 0.85rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;" @onclick="ToggleTheme" title="تغيير مظهر البرنامج">
                    <i class="fa-solid @(isDarkMode ? "fa-sun" : "fa-moon")" style="color: @(isDarkMode ? "#f59e0b" : "#6366f1")"></i>
                    <span>@(isDarkMode ? "المظهر الفاتح" : "المظهر الداكن")</span>
                </button>

                <div class="user-profile-badge">
                    <div class="user-avatar">
                        @((AuthState.UserFullName ?? "م")[0])
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">@(AuthState.UserFullName ?? "مستخدم الكاشير")</span>
                        <span style="font-size: 0.72rem; color: var(--accent-blue); font-weight: 600;">@(IsAdminOrManager ? "مدير النظام" : "كاشير")</span>
                    </div>
                </div>

                <button class="btn btn-secondary" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;" @onclick="Logout" title="تسجيل الخروج">
                    <i class="fa-solid fa-right-from-bracket me-1"></i> تسجيل خروج
                </button>
            </div>
        </header>

        <main class="page-body">
            @Body
        </main>
    </div>
</div>

<!-- Global Window Overlay (Opens target screen as a modal window on top of active page) -->
@if (!string.IsNullOrEmpty(activeModalRoute))
{
    <div class="global-window-overlay" @onclick="CloseGlobalModal">
        <div class="global-window-card" @onclick:stopPropagation="true">
            <div class="global-window-header">
                <div class="global-window-title">
                    <i class="fa-solid @GetModalIcon(activeModalRoute)" style="color: var(--accent-indigo);"></i>
                    <span>@GetModalTitle(activeModalRoute)</span>
                    <span class="badge badge-indigo ms-2" style="font-size: 0.75rem;">نافذة منبثقة فوق الشاشة [Esc لإغلاق]</span>
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <button class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;" @onclick="NavigateToModalPageFull" title="الانتقال الكامل لهذه الشاشة">
                        <i class="fa-solid fa-up-right-from-square me-1"></i> فتح الشاشة بالكامل
                    </button>
                    <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;" @onclick="CloseGlobalModal" title="إغلاق النافذة (Esc)">
                        <i class="fa-solid fa-xmark me-1"></i> إغلاق (Esc)
                    </button>
                </div>
            </div>
            <div class="global-window-body">
                @switch (activeModalRoute)
                {
                    case "price-check":
                        <PriceCheck />
                        break;
                    case "products":
                        <Products />
                        break;
                    case "shifts":
                        <Shifts />
                        break;
                    case "sales":
                        <SalesList />
                        break;
                    case "purchases":
                        <Purchases />
                        break;
                    case "expenses":
                        <Expenses />
                        break;
                    case "dashboard":
                        <Dashboard />
                        break;
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isDarkMode = true;
    private string? activeModalRoute;

    private bool IsAdminOrManager =>
        string.Equals(AuthState.UserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Administrator", StringComparison.OrdinalIgnoreCase);

    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getAppTheme");
                isDarkMode = theme != "light";
                await JS.InvokeVoidAsync("setAppTheme", isDarkMode ? "dark" : "light");

                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initGlobalNavigationShortcuts", _dotNetRef);

                StateHasChanged();
            }
            catch
            {
                // Fallback if JS call fails during startup
            }
        }
    }

    [JSInvokable]
    public void OpenQuickWindow(string route)
    {
        if (route == "pos" || route == "home" || string.IsNullOrEmpty(route))
        {
            activeModalRoute = null;
            Nav.NavigateTo(route);
        }
        else
        {
            activeModalRoute = route;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnGlobalEscPressed()
    {
        if (!string.IsNullOrEmpty(activeModalRoute))
        {
            activeModalRoute = null;
            StateHasChanged();
        }
    }

    private void CloseGlobalModal()
    {
        activeModalRoute = null;
        StateHasChanged();
    }

    private void NavigateToModalPageFull()
    {
        var targetRoute = activeModalRoute;
        activeModalRoute = null;
        if (!string.IsNullOrEmpty(targetRoute))
        {
            Nav.NavigateTo(targetRoute);
        }
    }

    private string GetModalIcon(string route) => route switch
    {
        "price-check" => "fa-barcode",
        "products" => "fa-boxes-stacked",
        "shifts" => "fa-clock-rotate-left",
        "sales" => "fa-receipt",
        "purchases" => "fa-truck-field",
        "expenses" => "fa-wallet",
        "dashboard" => "fa-chart-pie",
        _ => "fa-window-restore"
    };

    private string GetModalTitle(string route) => route switch
    {
        "price-check" => "استعلام الأسعار بالباركود",
        "products" => "كتالوج المنتجات والمخزون",
        "shifts" => "إدارة الورديات والخزينة",
        "sales" => "سجل المبيعات والفواتير",
        "purchases" => "شاشة المشتريات والواردات",
        "expenses" => "إدارة المصروفات",
        "dashboard" => "لوحة البيانات والتقارير",
        _ => "نافذة منبثقة"
    };

    protected override void OnInitialized()
    {
        ShiftState.OnShiftStateChanged += StateHasChanged;
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        var themeStr = isDarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("setAppTheme", themeStr);
    }

    private void Logout()
    {
        AuthState.MarkUserAsLoggedOut();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        ShiftState.OnShiftStateChanged -= StateHasChanged;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
