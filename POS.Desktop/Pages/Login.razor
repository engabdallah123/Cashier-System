@page "/login"
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@inject PosApiClient ApiClient
@inject CustomAuthStateProvider AuthState
@inject NavigationManager Nav

<div style="height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bg-primary);">
    <div class="modal-card" style="width: 400px;">
        <div class="text-center mb-4">
            <i class="fa-solid fa-cash-register" style="font-size: 3rem; color: var(--accent-blue);"></i>
            <h2 style="margin-top: 0.5rem; font-weight: 700;">POS Cashier Login</h2>
            <p style="color: var(--text-secondary); font-size: 0.85rem;">Enter your credentials to access the terminal</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background-color: rgba(239,68,68,0.2); border: 1px solid var(--accent-red); color: #f87171; padding: 0.6rem; border-radius: 0.5rem; font-size: 0.85rem; margin-bottom: 1rem;">
                @errorMessage
            </div>
        }

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <div style="margin-bottom: 1rem;">
                <label style="font-size: 0.85rem; color: var(--text-secondary); font-weight: 600; display: block; margin-bottom: 0.3rem;">Username</label>
                <InputText @bind-Value="loginModel.Username" class="search-box" style="width: 100%; padding: 0.75rem; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 0.5rem; color: white;" placeholder="admin / cashier" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="font-size: 0.85rem; color: var(--text-secondary); font-weight: 600; display: block; margin-bottom: 0.3rem;">Password</label>
                <InputText @bind-Value="loginModel.Password" type="password" style="width: 100%; padding: 0.75rem; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 0.5rem; color: white;" placeholder="******" />
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem;" disabled="@isLoading">
                @if (isLoading)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i> <span>Authenticating...</span>
                }
                else
                {
                    <i class="fa-solid fa-right-to-bracket"></i> <span>Login to POS</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequest loginModel = new("admin", "Admin123!");
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await ApiClient.LoginAsync(loginModel);
            if (res is not null)
            {
                var role = res.Roles.FirstOrDefault() ?? "Cashier";
                AuthState.MarkUserAsAuthenticated(res.Token, res.FullName, role, Guid.Empty);
                Nav.NavigateTo(role == "Admin" ? "/dashboard" : "/");
            }
            else
            {
                errorMessage = "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
