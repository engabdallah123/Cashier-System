@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@attribute [Authorize(Roles = "Admin,Manager")]
@inject PosApiClient ApiClient

<div>
    <h2 style="font-weight: 700; margin-bottom: 1.5rem;">Supermarket Dashboard</h2>

    @if (isLoading)
    {
        <div style="text-align: center; padding: 3rem;">
            <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
            <p style="margin-top: 0.5rem; color: var(--text-secondary);">Calculating metrics...</p>
        </div>
    }
    else if (data is not null)
    {
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background: var(--bg-secondary); padding: 1.2rem; border-radius: 0.75rem; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-secondary);">Total Sales</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent-green); margin-top: 0.3rem;">@data.TotalSales.ToString("N2") EGP</div>
            </div>

            <div style="background: var(--bg-secondary); padding: 1.2rem; border-radius: 0.75rem; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-secondary);">Net Profit</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent-blue); margin-top: 0.3rem;">@data.NetProfit.ToString("N2") EGP</div>
            </div>

            <div style="background: var(--bg-secondary); padding: 1.2rem; border-radius: 0.75rem; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-secondary);">Total Purchases</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent-amber); margin-top: 0.3rem;">@data.TotalPurchases.ToString("N2") EGP</div>
            </div>

            <div style="background: var(--bg-secondary); padding: 1.2rem; border-radius: 0.75rem; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-secondary);">Low Stock Items</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent-red); margin-top: 0.3rem;">@data.LowStockCount</div>
            </div>
        </div>

        <div class="modal-card" style="width: 100%;">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;">Top 5 Selling Products</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Qty Sold</th>
                        <th>Total Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in data.TopSellingProducts)
                    {
                        <tr>
                            <td style="font-weight: 600;">@prod.Name</td>
                            <td>@prod.TotalQuantitySold.ToString("N0")</td>
                            <td style="color: var(--accent-green); font-weight: 700;">@prod.TotalRevenue.ToString("N2") EGP</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DashboardDataDto? data;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        data = await ApiClient.GetDashboardAsync();
        isLoading = false;
    }
}
