@page "/sales"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Printing
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject IInvoicePrinterService Printer

<div>
    <div class="page-header">
        <div>
            <h2 class="page-title">سجل فواتير المبيعات</h2>
            <p class="page-subtitle">استعراض المبيعات وطباعة الإيصالات</p>
        </div>
    </div>

    <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: center;">
        <div class="search-box" style="max-width: 380px;">
            <i class="fa-solid fa-search"></i>
            <input @bind="searchQuery" @bind:event="oninput" @onkeyup="FilterSales" placeholder="ابحث برقم الفاتورة أو اسم الكاشير..." />
        </div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">
            إجمالي الفواتير: <strong style="color: var(--text-primary);">@filteredSales.Count</strong>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>رقم الفاتورة</th>
                    <th>التاريخ والوقت</th>
                    <th>الكاشير</th>
                    <th>طريقة الدفع</th>
                    <th>الخصم</th>
                    <th>الضريبة</th>
                    <th>المبلغ الإجمالي</th>
                    <th style="width: 130px; text-align: center;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                            <p style="margin-top: 0.5rem;">جاري تحميل سجل المبيعات...</p>
                        </td>
                    </tr>
                }
                else if (!filteredSales.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            <i class="fa-solid fa-receipt" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                            لا توجد فواتير مبيعات مطابقة.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sale in PagedSales)
                    {
                        <tr>
                            <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@sale.InvoiceNumber</code></td>
                            <td>@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(sale.CashierName) ? "مستخدم كاشير" : sale.CashierName)</td>
                            <td>
                                <span class="badge @(sale.PaymentMethod == "Cash" ? "badge-green" : "badge-indigo")">
                                    @(sale.PaymentMethod == "Cash" ? "نقداً (كاش)" : sale.PaymentMethod)
                                </span>
                            </td>
                            <td style="color: var(--accent-amber);">@sale.DiscountAmount.ToString("N2") ج.م</td>
                            <td>@sale.TaxAmount.ToString("N2") ج.م</td>
                            <td style="color: var(--accent-emerald); font-weight: 700;">@sale.TotalAmount.ToString("N2") ج.م</td>
                            <td style="text-align: center;">
                                <button class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;" @onclick="() => PrintPdf(sale.Id)" title="طباعة الفاتورة">
                                    <i class="fa-solid fa-print me-1"></i> طباعة
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="@currentPage" TotalItems="@filteredSales.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; EnsureValidPage(); })" />
</div>

@code {
    private List<SaleDto> sales = new();
    private List<SaleDto> filteredSales = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<SaleDto> PagedSales => filteredSales.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private string searchQuery = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSales();
    }

    private async Task LoadSales()
    {
        isLoading = true;
        sales = await ApiClient.GetSalesListAsync();
        FilterSales();
        isLoading = false;
    }

    private void FilterSales()
    {
        currentPage = 1;
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredSales = sales.ToList();
        }
        else
        {
            filteredSales = sales.Where(s =>
                s.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (s.CashierName != null && s.CashierName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
        }
        EnsureValidPage();
    }

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredSales.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private async Task PrintPdf(Guid saleId)
    {
        try
        {
            await Printer.PrintInvoiceAsync(saleId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing invoice: {ex.Message}");
        }
    }
}
