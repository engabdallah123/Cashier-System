@page "/pos"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@using global::POS.Desktop.Services.State
@using global::POS.Desktop.Services.Printing
@attribute [Authorize]
@implements IDisposable
@inject PosApiClient ApiClient
@inject CartStateContainer Cart
@inject ShiftStateContainer Shift
@inject CustomAuthStateProvider AuthState
@inject IInvoicePrinterService Printer
@inject IJSRuntime JS

<div class="pos-layout">
    <!-- Left Panel: Catalog & Search -->
    <div class="catalog-panel">
        <div style="display: flex; gap: 0.75rem;">
            <!-- Barcode Scanner HID Input -->
            <div class="search-box" style="flex: 1;">
                <i class="fa-solid fa-barcode"></i>
                <input id="pos-barcode-input"
                       @ref="barcodeInputRef" 
                       @bind="scannedBarcode" 
                       @bind:event="oninput" 
                       @onkeyup="HandleBarcodeKeyUp"
                       placeholder="امسح الباركود أو أدخله يدوياً... [F2 / Enter]" 
                       style="border-color: var(--accent-blue);" />
            </div>

            <!-- Product Search Input -->
            <div class="search-box" style="flex: 1;">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input @bind="searchTerm" 
                       @bind:event="oninput" 
                       @onkeyup="SearchProducts" 
                       placeholder="ابحث عن منتج بالاسم... [F1]" />
            </div>
        </div>

        <!-- Categories Bar -->
        <div class="category-bar">
            <button class="cat-btn @(selectedCategoryId == null ? "active" : "")" @onclick="() => FilterByCategory(null)">
                جميع التصنيفات
            </button>
            @foreach (var cat in categories)
            {
                <button class="cat-btn @(selectedCategoryId == cat.Id ? "active" : "")" @onclick="() => FilterByCategory(cat.Id)">
                    @cat.NameAr
                </button>
            }
        </div>

        <!-- Products Grid -->
        <div class="products-grid">
            @if (isLoadingProducts)
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                    <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                    <p style="margin-top: 0.5rem; color: var(--text-secondary);">جاري تحميل الكتالوج...</p>
                </div>
            }
            else if (!filteredProducts.Any())
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 2rem; color: var(--text-secondary);">
                    <i class="fa-solid fa-box-open fa-2x"></i>
                    <p style="margin-top: 0.5rem;">لا توجد منتجات مطابقة</p>
                </div>
            }
            else
            {
                @foreach (var prod in PagedProducts)
                {
                    <div class="product-card" @onclick="() => AddToCart(prod)">
                        <div class="product-card-img-container">
                            @if (!string.IsNullOrWhiteSpace(prod.ImageUrl))
                            {
                                var resolvedUrl = ApiClient.GetImageFullUrl(prod.ImageUrl);
                                <img src="@resolvedUrl" class="product-card-img" alt="@prod.NameAr" onerror="this.onerror=null; this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <div class="product-card-img-placeholder" style="display:none;">
                                    <i class="fa-solid fa-box"></i>
                                </div>
                            }
                            else
                            {
                                <div class="product-card-img-placeholder">
                                    <i class="fa-solid fa-box"></i>
                                </div>
                            }
                        </div>
                        <div class="product-card-body">
                            <div class="product-title" title="@prod.NameAr">@prod.NameAr</div>
                            <div class="product-stock">المخزون: @prod.QuantityInStock.ToString("N0") @(prod.UnitSymbol ?? "قطع")</div>
                        </div>
                        <div class="product-card-footer">
                            <span class="product-price">@prod.SellingPrice.ToString("N2") ج.م</span>
                            <i class="fa-solid fa-plus-circle"></i>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Pagination Controls Bar -->
        <Pagination CurrentPage="@currentPage" TotalItems="@filteredProducts.Count" PageSize="@pageSize" OnPageChanged="@(p => GoToPage(p))" />
    </div>


    <!-- Right Panel: Cart & Actions -->
    <div class="cart-panel">
        <div class="cart-header">
            <div>
                <h3 style="font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                    <span>سلة المبيعات</span>
                    <span style="font-size: 0.75rem; background: var(--accent-indigo); color: white; padding: 0.15rem 0.5rem; border-radius: 1rem; font-weight: 600;">@Cart.Items.Count</span>
                </h3>
                <span style="font-size: 0.8rem; color: var(--text-secondary);">العميل: @(Cart.CustomerName == "Walk-in Customer" ? "عميل نقدي" : Cart.CustomerName)</span>
            </div>
            <button class="btn btn-amber" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;" @onclick="OpenCustomerModal">
                <i class="fa-solid fa-user me-1"></i> العميل [F2]
            </button>
        </div>

        <!-- Cart Items List -->
        <div class="cart-items">
            @if (!Cart.Items.Any())
            {
                <div style="text-align: center; margin: auto; color: var(--text-secondary); padding: 3rem 0;">
                    <i class="fa-solid fa-cart-shopping fa-3x" style="opacity: 0.3;"></i>
                    <p style="margin-top: 0.5rem;">السلة فارغة. قم بمسح أو اختيار المنتجات.</p>
                </div>
            }
            else
            {
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th style="width: 24px; text-align: center;">#</th>
                            <th style="text-align: right;">المنتج</th>
                            <th style="width: 80px; text-align: center;">الكمية</th>
                            <th style="width: 80px; text-align: left;">الإجمالي</th>
                            <th style="width: 26px; text-align: center;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 1; }
                        @foreach (var item in Cart.Items)
                        {
                            var currentIndex = idx++;
                            <tr>
                                <td style="text-align: center; color: var(--text-muted); font-size: 0.75rem;">@currentIndex</td>
                                <td>
                                    <div style="font-weight: 700; color: var(--text-primary); font-size: 0.85rem; line-height: 1.2;">@item.ProductName</div>
                                    <div style="font-size: 0.75rem; color: var(--text-secondary);">@item.UnitPrice.ToString("N2") ج.م</div>
                                </td>
                                <td style="text-align: center;">
                                    <div class="qty-controls">
                                        <button class="qty-btn" @onclick="() => Cart.UpdateQuantity(item.ProductId, item.Quantity - 1)">-</button>
                                        <span style="font-weight: 700; width: 20px; text-align: center; font-size: 0.85rem; color: var(--accent-amber);">@item.Quantity.ToString("N0")</span>
                                        <button class="qty-btn" @onclick="() => Cart.UpdateQuantity(item.ProductId, item.Quantity + 1)">+</button>
                                    </div>
                                </td>
                                <td style="text-align: left; font-weight: 700; color: var(--accent-emerald); font-size: 0.86rem;">
                                    @item.LineTotal.ToString("N2")
                                </td>
                                <td style="text-align: center;">
                                    <button class="qty-btn" style="background: rgba(239, 68, 68, 0.15); color: var(--accent-red); border-color: rgba(239, 68, 68, 0.3);" @onclick="() => Cart.RemoveItem(item.ProductId)" title="حذف">
                                        <i class="fa-solid fa-xmark" style="font-size: 0.75rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Cart Totals Summary -->
        <div class="cart-summary">
            <div class="summary-row">
                <span>المجموع الفرعي</span>
                <span>@Cart.SubTotal.ToString("N2") ج.م</span>
            </div>
            <div class="summary-row" style="color: var(--accent-amber);">
                <span>إجمالي الخصم</span>
                <span>-@Cart.TotalDiscount.ToString("N2") ج.م</span>
            </div>
            <div class="summary-row">
                <span>إجمالي الضريبة</span>
                <span>+@Cart.TotalTax.ToString("N2") ج.م</span>
            </div>
            <div class="summary-row total">
                <span>الإجمالي الكلي</span>
                <span>@Cart.GrandTotal.ToString("N2") ج.م</span>
            </div>
        </div>

        <!-- Action Buttons Grid -->
        <div class="pos-actions">
            <button class="btn btn-danger" @onclick="() => Cart.Clear()">
                <i class="fa-solid fa-xmark me-1"></i> إلغاء الفاتورة [Esc]
            </button>
            <button class="btn btn-success" disabled="@(!Cart.Items.Any() || isProcessingSale)" @onclick="OpenPaymentModal">
                <i class="fa-solid fa-money-bill-wave me-1"></i> إتمام الدفع [F8]
            </button>
        </div>
    </div>
</div>

<!-- Checkout Payment Modal -->
@if (showPaymentModal)
{
    <div class="modal-overlay" @onclick="ClosePaymentModal">
        <div class="modal-card" style="width: 580px; max-width: 95vw;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-cash-register me-2" style="color: var(--accent-emerald);"></i>
                    الدفع وإنهاء الفاتورة
                </h3>
                <button class="btn btn-secondary" style="padding: 0.35rem 0.65rem;" @onclick="ClosePaymentModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" style="max-height: 82vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(saleError))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @saleError
                    </div>
                }

                <!-- Customer & Products Review Section -->
                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 0.85rem 1rem; margin-bottom: 1.15rem; box-shadow: var(--shadow-sm);">
                    <div style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; @(isProductReviewExpanded ? "margin-bottom: 0.75rem; border-bottom: 1px solid var(--border-color-light); padding-bottom: 0.5rem;" : "")" @onclick="ToggleProductReview" title="انقر لإظهار أو إخفاء منتجات الفاتورة">
                        <div style="font-weight: 700; font-size: 0.9rem; color: var(--accent-indigo); display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fa-solid fa-list-check"></i>
                            <span>مراجعة منتجات الفاتورة (@Cart.Items.Count صنف)</span>
                            <i class="fa-solid @(isProductReviewExpanded ? "fa-chevron-up" : "fa-chevron-down")" style="font-size: 0.75rem; color: var(--text-muted);"></i>
                        </div>
                        <span style="font-size: 0.78rem; color: var(--text-secondary); background: rgba(99, 102, 241, 0.12); padding: 0.25rem 0.65rem; border-radius: 1rem; border: 1px solid rgba(99, 102, 241, 0.25);">
                            <i class="fa-solid fa-user me-1"></i> @(Cart.CustomerName == "Walk-in Customer" ? "عميل نقدي" : Cart.CustomerName)
                        </span>
                    </div>

                    @if (isProductReviewExpanded)
                    {
                        <div style="max-height: 180px; overflow-y: auto; padding-left: 0.3rem;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                                <thead>
                                    <tr style="color: var(--text-secondary); text-align: right; border-bottom: 1px dashed var(--border-color-light);">
                                        <th style="padding: 0.4rem 0.25rem; font-weight: 600;">المنتج</th>
                                        <th style="padding: 0.4rem 0.25rem; text-align: center; font-weight: 600;">الكمية</th>
                                        <th style="padding: 0.4rem 0.25rem; text-align: center; font-weight: 600;">سعر الوحدة</th>
                                        <th style="padding: 0.4rem 0.25rem; text-align: left; font-weight: 600;">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Cart.Items)
                                    {
                                        <tr style="border-bottom: 1px solid var(--border-color-light);">
                                            <td style="padding: 0.5rem 0.25rem; font-weight: 600; color: var(--text-primary);">@item.ProductName</td>
                                            <td style="padding: 0.5rem 0.25rem; text-align: center; color: var(--accent-amber); font-weight: 700;">@item.Quantity.ToString("N0")</td>
                                            <td style="padding: 0.5rem 0.25rem; text-align: center; color: var(--text-secondary);">@item.UnitPrice.ToString("N2") ج.م</td>
                                            <td style="padding: 0.5rem 0.25rem; text-align: left; font-weight: 700; color: var(--accent-emerald);">@item.LineTotal.ToString("N2") ج.م</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-card); padding: 1rem 1.25rem; border-radius: 0.75rem; border: 1px solid var(--border-color-light); margin-bottom: 1.25rem;">
                    <span style="font-size: 1rem; font-weight: 600; color: var(--text-secondary);">المبلغ المطلوب:</span>
                    <span style="font-size: 1.4rem; font-weight: 700; color: var(--accent-emerald);">@Cart.GrandTotal.ToString("N2") ج.م</span>
                </div>

                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label>طريقة الدفع</label>
                    <select class="form-select" @bind="Cart.PaymentMethod">
                        <option value="Cash">نقداً (كاش)</option>
                        <option value="Visa">بطاقة ائتمان (فيزا / كارت)</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label><i class="fa-solid fa-print me-1"></i> نوع طباعة الفاتورة</label>
                    <select class="form-select" @bind="selectedPrintType">
                        <option value="thermal">🧾 فاتورة حرارية (80mm)</option>
                        <option value="a4">📄 فاتورة عادية (A4)</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label>المبلغ المدفوع (جنيه)</label>
                    <input type="number" class="form-control" @bind="paidAmount" @bind:event="oninput" style="font-size: 1.15rem; font-weight: 700;" placeholder="0.00" />
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); padding: 0.9rem 1.25rem; border-radius: 0.6rem; color: var(--accent-amber);">
                    <span style="font-weight: 600; font-size: 0.95rem;">المبلغ المتبقي (الباقي):</span>
                    <span style="font-size: 1.2rem; font-weight: 700;">@Math.Max(0, paidAmount - Cart.GrandTotal).ToString("N2") ج.م</span>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" style="flex: 1;" @onclick="ClosePaymentModal">إلغاء</button>
                <button class="btn btn-success" style="flex: 2; padding: 0.75rem;" disabled="@isProcessingSale" @onclick="SubmitSale">
                    @if (isProcessingSale)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check-circle me-1"></i> <span>تأكيد الدفع وطباعة الفاتورة</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Customer Selection Modal -->
@if (showCustomerModal)
{
    <div class="modal-overlay" @onclick="CloseCustomerModal">
        <div class="modal-card" style="width: 580px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-user-tag me-2" style="color: var(--accent-amber);"></i>
                    اختيار أو إضافة عميل
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseCustomerModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(customerError))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @customerError
                    </div>
                }

                <!-- Toggle: Select Existing / Add New -->
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem;">
                    <button class="btn @(customerTab == "select" ? "btn-primary" : "btn-secondary")" style="flex: 1;" @onclick='() => customerTab = "select"'>
                        <i class="fa-solid fa-search me-1"></i> اختيار عميل موجود
                    </button>
                    <button class="btn @(customerTab == "new" ? "btn-primary" : "btn-secondary")" style="flex: 1;" @onclick='() => customerTab = "new"'>
                        <i class="fa-solid fa-user-plus me-1"></i> عميل جديد
                    </button>
                </div>

                @if (customerTab == "select")
                {
                    <!-- Search Existing Customers -->
                    <div class="search-box" style="margin-bottom: 1rem;">
                        <i class="fa-solid fa-search"></i>
                        <input @bind="customerSearchQuery" @bind:event="oninput" @onkeyup="FilterCustomers" placeholder="ابحث بالاسم أو رقم الهاتف..." />
                    </div>

                    <!-- Walk-in Customer Option -->
                    <div style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 0.5rem; border: 1px solid var(--border-color-light); background: @(Cart.CustomerId == null ? "rgba(99, 102, 241, 0.1)" : "var(--bg-card)");"
                         @onclick="SelectWalkInCustomer">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-amber); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.85rem;">
                                <i class="fa-solid fa-walking"></i>
                            </div>
                            <div>
                                <div style="font-weight: 700; font-size: 0.9rem;">عميل نقدي (Walk-in)</div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">بدون تسجيل بيانات عميل</div>
                            </div>
                        </div>
                        @if (Cart.CustomerId == null)
                        {
                            <i class="fa-solid fa-check-circle" style="color: var(--accent-indigo); font-size: 1.1rem;"></i>
                        }
                    </div>

                    <!-- Customer List -->
                    <div style="max-height: 250px; overflow-y: auto;">
                        @foreach (var cust in filteredCustomers)
                        {
                            <div style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 0.5rem; border: 1px solid var(--border-color-light); background: @(Cart.CustomerId == cust.Id ? "rgba(99, 102, 241, 0.1)" : "var(--bg-card)"); transition: all 0.15s ease;"
                                 @onclick="() => SelectCustomer(cust)">
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-indigo), #4f46e5); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.85rem; font-weight: 700;">
                                        @cust.Name.Substring(0, 1)
                                    </div>
                                    <div>
                                        <div style="font-weight: 700; font-size: 0.9rem;">@cust.Name</div>
                                        <div style="font-size: 0.78rem; color: var(--text-secondary);">
                                            <i class="fa-solid fa-phone" style="font-size: 0.7rem;"></i> @cust.Phone
                                        </div>
                                    </div>
                                </div>
                                @if (Cart.CustomerId == cust.Id)
                                {
                                    <i class="fa-solid fa-check-circle" style="color: var(--accent-indigo); font-size: 1.1rem;"></i>
                                }
                            </div>
                        }

                        @if (!filteredCustomers.Any())
                        {
                            <div style="text-align: center; padding: 1.5rem; color: var(--text-muted);">
                                <i class="fa-solid fa-user-slash" style="font-size: 1.5rem; margin-bottom: 0.5rem; display: block;"></i>
                                لا يوجد عملاء مطابقين. يمكنك إضافة عميل جديد.
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Add New Customer Form -->
                    <div class="form-group">
                        <label>اسم العميل <span style="color: var(--accent-red);">*</span></label>
                        <input class="form-control" @bind="newCustomerName" placeholder="مثال: أحمد محمد" />
                    </div>

                    <div class="form-group">
                        <label>رقم الهاتف <span style="color: var(--accent-red);">*</span></label>
                        <input class="form-control" @bind="newCustomerPhone" placeholder="مثال: 01012345678" />
                    </div>

                    <div class="form-group">
                        <label>البريد الإلكتروني</label>
                        <input class="form-control" @bind="newCustomerEmail" placeholder="email@example.com" />
                    </div>

                    <div class="form-group">
                        <label>العنوان</label>
                        <input class="form-control" @bind="newCustomerAddress" placeholder="العنوان (اختياري)" />
                    </div>

                    <button class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;" disabled="@isSavingCustomer" @onclick="SaveNewCustomer">
                        @if (isSavingCustomer)
                        {
                            <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-user-plus me-1"></i> <span>حفظ وربط العميل بالفاتورة</span>
                        }
                    </button>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCustomerModal">إغلاق</button>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference barcodeInputRef;
    private string scannedBarcode = string.Empty;
    private string searchTerm = string.Empty;

    private List<ProductDto> products = new();
    private List<ProductDto> filteredProducts = new();
    private List<CategoryDto> categories = new();
    private Guid? selectedCategoryId;

    private int currentPage = 1;
    private const int pageSize = 6;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredProducts.Count / pageSize));

    private IEnumerable<ProductDto> PagedProducts =>
        filteredProducts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    private bool isLoadingProducts = true;
    private bool showPaymentModal = false;
    private bool isProcessingSale = false;
    private string selectedPrintType = "thermal";
    private decimal paidAmount = 0;
    private string? saleError;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnCartChanged += StateHasChanged;
        if (AuthState.UserId != Guid.Empty && !Shift.IsShiftOpen)
        {
            var activeShift = await ApiClient.GetCurrentShiftAsync(AuthState.UserId);
            if (activeShift != null && activeShift.Status == "Open")
            {
                Shift.SetActiveShift(activeShift.Id, activeShift.OpenedAt, activeShift.OpeningCash);
            }
        }
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        isLoadingProducts = true;
        try
        {
            products = await ApiClient.GetProductsAsync();
            categories = await ApiClient.GetCategoriesAsync();
            filteredProducts = products;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private async Task HandleBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(scannedBarcode))
        {
            var code = scannedBarcode.Trim();
            scannedBarcode = string.Empty;

            var prod = await ApiClient.GetProductByBarcodeAsync(code);
            if (prod is not null)
            {
                AddToCart(prod);
            }
            else
            {
                saleError = $"المنتج بالباركود '{code}' غير موجود.";
            }
        }
    }

    private void AddToCart(ProductDto prod)
    {
        saleError = null;
        Cart.AddOrIncrementProduct(prod.Id, prod.Barcode, prod.NameAr, prod.SellingPrice, prod.TaxRate);
    }

    private void SearchProducts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredProducts = selectedCategoryId == null ? products : products.Where(p => p.CategoryId == selectedCategoryId).ToList();
        }
        else
        {
            filteredProducts = products.Where(p => p.NameAr.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Barcode.Contains(searchTerm)).ToList();
        }
        currentPage = 1;
    }

    private void FilterByCategory(Guid? catId)
    {
        selectedCategoryId = catId;
        SearchProducts();
    }

    private void OpenPaymentModal()
    {
        paidAmount = Cart.GrandTotal;
        saleError = null;
        showPaymentModal = true;
    }

    private void ClosePaymentModal() => showPaymentModal = false;

    private async Task SubmitSale()
    {
        if (!Shift.IsShiftOpen)
        {
            saleError = "لا يمكن إتمام البيع: لا توجد وردية مفتوحة حالياً. الرجاء فتح وردية أولاً من صفحة الورديات.";
            return;
        }

        if (paidAmount + 0.01m < Cart.GrandTotal && !Cart.PaymentMethod.Equals("Credit", StringComparison.OrdinalIgnoreCase))
        {
            saleError = $"المبلغ المدفوع ({paidAmount:N2} ج.م) أقل من إجمالي الفاتورة المطلوب ({Cart.GrandTotal:N2} ج.m).";
            return;
        }

        isProcessingSale = true;
        saleError = null;

        try
        {
            var saleItems = Cart.Items.Select(i => new CreateSaleItemRequest(
                i.ProductId,
                i.Quantity,
                i.UnitPrice,
                i.Discount,
                i.LineTax)).ToList();

            var cmd = new CreateSaleCommand(
                CashierId: AuthState.UserId,
                ShiftId: Shift.ShiftId,
                Items: saleItems,
                CustomerId: Cart.CustomerId,
                DiscountAmount: Cart.TotalDiscount,
                TaxAmount: Cart.TotalTax,
                PaidAmount: paidAmount,
                PaymentMethod: Cart.PaymentMethod,
                Notes: "POS Desktop Sale");

            var (saleId, error) = await ApiClient.CreateSaleAsync(cmd);
            if (saleId.HasValue)
            {
                var createdId = saleId.Value;
                Cart.Clear();
                ClosePaymentModal();

                bool isThermal = selectedPrintType == "thermal";
                await Printer.PrintInvoiceAsync(createdId, isThermal);
            }
            else
            {
                saleError = !string.IsNullOrEmpty(error) ? error : "فشل إنشاء عملية البيع. الرجاء مراجعة الوردية الحالية.";
            }
        }
        catch (Exception ex)
        {
            saleError = $"خطأ في عملية البيع: {ex.Message}";
        }
        finally
        {
            isProcessingSale = false;
        }
    }

    // Customer Modal State
    private bool showCustomerModal = false;
    private string customerTab = "select";
    private List<CustomerDto> allCustomers = new();
    private List<CustomerDto> filteredCustomers = new();
    private string customerSearchQuery = string.Empty;
    private string customerError = string.Empty;
    private bool isSavingCustomer = false;

    private string newCustomerName = string.Empty;
    private string newCustomerPhone = string.Empty;
    private string? newCustomerEmail;
    private string? newCustomerAddress;

    private async Task OpenCustomerModal()
    {
        customerError = string.Empty;
        customerTab = "select";
        customerSearchQuery = string.Empty;
        newCustomerName = string.Empty;
        newCustomerPhone = string.Empty;
        newCustomerEmail = null;
        newCustomerAddress = null;
        allCustomers = await ApiClient.GetCustomersAsync();
        filteredCustomers = allCustomers.ToList();
        showCustomerModal = true;
    }

    private void CloseCustomerModal() => showCustomerModal = false;

    private void FilterCustomers()
    {
        if (string.IsNullOrWhiteSpace(customerSearchQuery))
        {
            filteredCustomers = allCustomers.ToList();
        }
        else
        {
            filteredCustomers = allCustomers.Where(c =>
                c.Name.Contains(customerSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Phone.Contains(customerSearchQuery)).ToList();
        }
    }

    private void SelectCustomer(CustomerDto cust)
    {
        Cart.CustomerId = cust.Id;
        Cart.CustomerName = cust.Name;
        CloseCustomerModal();
    }

    private void SelectWalkInCustomer()
    {
        Cart.CustomerId = null;
        Cart.CustomerName = "Walk-in Customer";
        CloseCustomerModal();
    }

    private async Task SaveNewCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomerName))
        {
            customerError = "الرجاء إدخال اسم العميل.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newCustomerPhone))
        {
            customerError = "الرجاء إدخال رقم هاتف العميل.";
            return;
        }

        isSavingCustomer = true;
        customerError = string.Empty;

        var req = new CreateCustomerRequest(newCustomerName, newCustomerPhone, newCustomerEmail, newCustomerAddress);
        var (id, error) = await ApiClient.CreateCustomerAsync(req);
        isSavingCustomer = false;

        if (id.HasValue)
        {
            Cart.CustomerId = id.Value;
            Cart.CustomerName = newCustomerName;
            CloseCustomerModal();
        }
        else
        {
            customerError = !string.IsNullOrEmpty(error) ? error : "فشل إضافة العميل.";
        }
    }

    private DotNetObjectReference<POS>? _dotNetRef;
    private bool isProductReviewExpanded = true;

    private void ToggleProductReview()
    {
        isProductReviewExpanded = !isProductReviewExpanded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initPosPageShortcuts", _dotNetRef);
                await JS.InvokeVoidAsync("focusElementById", "pos-barcode-input");
            }
            catch
            {
                // Fallback if JS call fails
            }
        }
    }

    [JSInvokable]
    public async Task OnPosShortcutPressed(string key)
    {
        if (key == "F2")
        {
            await JS.InvokeVoidAsync("focusElementById", "pos-barcode-input");
        }
        else if (key == "F4" || key == "F8")
        {
            if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
            {
                OpenPaymentModal();
            }
        }
        else if (key == "F9")
        {
            if (Cart.Items.Any())
            {
                Cart.Clear();
            }
        }
        else if (key == "Escape")
        {
            if (showPaymentModal)
            {
                ClosePaymentModal();
            }
            else if (showCustomerModal)
            {
                CloseCustomerModal();
            }
            else if (Cart.Items.Any())
            {
                Cart.Clear();
            }
            else
            {
                await JS.InvokeVoidAsync("focusElementById", "pos-barcode-input");
            }
        }
        StateHasChanged();
    }

    private string GetImageFullUrl(string? relativeOrUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeOrUrl)) return string.Empty;
        return ApiClient.GetImageFullUrl(relativeOrUrl);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        Cart.OnCartChanged -= StateHasChanged;
    }
}
