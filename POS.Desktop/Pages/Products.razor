@page "/products"
@using System.IO
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject CustomAuthStateProvider AuthState
@inject IJSRuntime JS

<div>
    <div class="page-header">
        <div>
            <h2 class="page-title">كتالوج المنتجات والمخزون</h2>
            <p class="page-subtitle">إدارة المنتجات والأسعار وحدود الطلب والتصنيفات</p>
        </div>
        @if (AuthState.UserRole == "Admin")
        {
            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <button class="btn btn-secondary" @onclick="DownloadExcelTemplate" title="تحميل قالب إكسيل معبأ بالأنواع والترويسة النموذجية">
                    <i class="fa-solid fa-file-excel me-1" style="color: #107c41;"></i> تحميل القالب
                </button>
                <button class="btn btn-secondary" style="background: rgba(16, 124, 65, 0.15); border-color: #107c41; color: #107c41;" @onclick="OpenImportModal">
                    <i class="fa-solid fa-file-import me-1"></i> استيراد من إكسيل
                </button>
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <i class="fa-solid fa-plus me-1"></i> إضافة منتج جديد
                </button>
            </div>
        }
    </div>

    <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: center; flex-wrap: wrap;">
        <div class="search-box" style="max-width: 380px; flex: 1;">
            <i class="fa-solid fa-search"></i>
            <input @bind="search" @bind:event="oninput" @onkeyup="Filter" placeholder="تصفية بالاسم أو الباركود..." />
        </div>
        <div class="search-box" style="max-width: 320px; flex: 1;">
            <i class="fa-solid fa-barcode" style="color: var(--accent-indigo);"></i>
            <input @bind="quickScanBarcode" @bind:event="oninput" @onkeyup="HandleQuickScanBarcodeKeyUp" placeholder="مسح باركود صنف للتسجيل... [Enter]" style="border-color: var(--accent-indigo);" />
        </div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">
            إجمالي المنتجات: <strong style="color: var(--text-primary);">@filtered.Count</strong>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>الباركود</th>
                    <th>الاسم (عربي)</th>
                    <th>الاسم (إنجليزي)</th>
                    <th>التصنيف</th>
                    <th>سعر البيع</th>
                    <th>المخزون</th>
                    <th>الحالة</th>
                    @if (AuthState.UserRole == "Admin")
                    {
                        <th style="width: 120px; text-align: center;">الإجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!filtered.Any())
                {
                    <tr>
                        <td colspan="@(AuthState.UserRole == "Admin" ? 8 : 7)" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                            <i class="fa-solid fa-box-open" style="font-size: 2.2rem; margin-bottom: 0.5rem; display: block;"></i>
                            لا توجد منتجات في الكتالوج حالياً.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in PagedProducts)
                    {
                        <tr>
                            <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@prod.Barcode</code></td>
                            <td style="font-weight: 600;">@prod.NameAr</td>
                            <td>@prod.NameEn</td>
                            <td>
                                <span class="badge badge-indigo">
                                    @(prod.CategoryName ?? "عام")
                                </span>
                            </td>
                            <td style="color: var(--accent-emerald); font-weight: 700;">@prod.SellingPrice.ToString("N2") ج.م</td>
                            <td>@prod.QuantityInStock.ToString("N0") @(prod.UnitSymbol ?? "قطع")</td>
                            <td>
                                <span class="badge @(prod.IsActive ? "badge-green" : "badge-red")">
                                    <i class="fa-solid fa-circle" style="font-size: 0.45rem;"></i>
                                    @(prod.IsActive ? "نشط" : "غير نشط")
                                </span>
                            </td>
                            @if (AuthState.UserRole == "Admin")
                            {
                                <td style="text-align: center;">
                                    <div style="display: flex; gap: 0.35rem; justify-content: center;">
                                        <button class="btn btn-secondary" style="padding: 0.3rem 0.5rem; font-size: 0.8rem;" @onclick="() => OpenEditModal(prod)" title="تعديل المنتج">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button class="btn btn-danger" style="padding: 0.3rem 0.5rem; font-size: 0.8rem;" @onclick="() => ConfirmDeleteProduct(prod)" title="حذف المنتج">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="@currentPage" TotalItems="@filtered.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; EnsureValidPage(); })" />
</div>


<!-- Add / Edit Modal -->
@if (showAddModal || showEditModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 750px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid @(showEditModal ? "fa-pen-to-square" : "fa-box-archive") me-2" style="color: var(--accent-indigo);"></i>
                    @(showEditModal ? "تعديل بيانات المنتج" : "إضافة منتج جديد")
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div class="grid-2">
                    <div class="form-group">
                        <label>الباركود <span style="color: var(--accent-red);">*</span></label>
                        <div style="display: flex; gap: 0.4rem;">
                            <input class="form-control" @bind="newProduct.Barcode" placeholder="امسح أو أدخل الباركود..." />
                            <button class="btn btn-secondary" type="button" @onclick="FetchOnlineProductInfo" disabled="@isFetchingOnline" title="جلب اسم المنتج والصورة أونلاين عبر الباركود">
                                @if (isFetchingOnline)
                                {
                                    <i class="fa-solid fa-spinner fa-spin"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-globe me-1" style="color: var(--accent-blue);"></i> <span>جلب 🌐</span>
                                }
                            </button>
                            <button class="btn btn-secondary" type="button" @onclick="GenerateBarcode" title="توليد باركود تلقائي راندوم">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>التصنيف <span style="color: var(--accent-red);">*</span></label>
                        <select class="form-select" @bind="categoryIdString">
                            <option value="">-- اختر التصنيف --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id.ToString()">@cat.NameAr (@cat.NameEn)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>الاسم (بالعربية) <span style="color: var(--accent-red);">*</span></label>
                        <input class="form-control" @bind="newProduct.NameAr" placeholder="مثال: حليب كامل الدسم 1 لتر" />
                    </div>

                    <div class="form-group">
                        <label>الاسم (بالإنجليزية) <span style="color: var(--accent-red);">*</span></label>
                        <input class="form-control" @bind="newProduct.NameEn" placeholder="مثال: Full Cream Milk 1L" />
                    </div>
                </div>

                <div class="grid-3">
                    <div class="form-group">
                        <label>الوحدة <span style="color: var(--accent-red);">*</span></label>
                        <select class="form-select" @bind="unitIdString">
                            <option value="">-- اختر الوحدة --</option>
                            @foreach (var u in units)
                            {
                                <option value="@u.Id.ToString()">@u.NameAr (@u.Symbol)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>المورد (اختياري)</label>
                        <select class="form-select" @bind="supplierIdString">
                            <option value="">-- اختر المورد --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id.ToString()">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>نسبة الضريبة (%)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.TaxRate" placeholder="14" />
                    </div>
                </div>

                <div class="grid-3">
                    <div class="form-group">
                        <label>سعر التكلفة / الشراء (جنيه)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.PurchasePrice" />
                    </div>

                    <div class="form-group">
                        <label>سعر البيع للقطاعي (جنيه) <span style="color: var(--accent-red);">*</span></label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.SellingPrice" />
                    </div>

                    <div class="form-group">
                        <label>سعر البيع للجملة (جنيه)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.WholesalePrice" />
                    </div>
                </div>

                @if (!showEditModal)
                {
                    <div class="grid-3">
                        <div class="form-group">
                            <label>الرصيد الافتتاحي للمخزون</label>
                            <input type="number" class="form-control" @bind="newProduct.InitialStock" placeholder="0" />
                        </div>

                        <div class="form-group">
                            <label>حد إعادة الطلب</label>
                            <input type="number" class="form-control" @bind="newProduct.ReorderLevel" />
                        </div>

                        <div class="form-group">
                            <label>الحد الأقصى للمخزون</label>
                            <input type="number" class="form-control" @bind="newProduct.MaxStockLevel" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid-2">
                        <div class="form-group">
                            <label>حد إعادة الطلب</label>
                            <input type="number" class="form-control" @bind="newProduct.ReorderLevel" />
                        </div>

                        <div class="form-group">
                            <label>الحد الأقصى للمخزون</label>
                            <input type="number" class="form-control" @bind="newProduct.MaxStockLevel" />
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label>الوصف والملاحظات</label>
                    <textarea class="form-control" rows="2" @bind="newProduct.Description" placeholder="ملاحظات اختيارية..."></textarea>
                </div>

                @if (!showEditModal)
                {
                    <div class="form-group">
                        <label>صورة المنتج (اختيارية - كالمحلات والسوبرماركت)</label>
                        <div class="file-upload-box" style="position: relative;">
                            @if (!string.IsNullOrEmpty(imagePreviewUrl))
                            {
                                <div style="text-align: center; margin-bottom: 0.5rem;">
                                    <img src="@imagePreviewUrl" style="max-height: 100px; border-radius: 0.5rem; border: 1px solid var(--border-color); object-fit: contain;" alt="صورة المنتج" />
                                    <div style="font-size: 0.75rem; color: var(--accent-emerald); font-weight: 600; margin-top: 0.25rem;">
                                        <i class="fa-solid fa-circle-check me-1"></i> تم اختيار الصورة بنجاح
                                    </div>
                                </div>
                            }
                            else
                            {
                                <i class="fa-solid fa-cloud-arrow-up" style="font-size: 1.8rem; color: var(--accent-indigo); margin-bottom: 0.5rem;"></i>
                                <div style="font-size: 0.85rem; color: var(--text-secondary);">اضغط لاختيار صورة يدوية أو سيتم الاعتماد على الأيقونة الافتراضية</div>
                            }
                            @if (!string.IsNullOrEmpty(selectedFileName))
                            {
                                <div style="margin-top: 0.25rem; color: var(--accent-indigo); font-weight: 600; font-size: 0.8rem;">
                                    <i class="fa-solid fa-file-image me-1"></i> @selectedFileName
                                </div>
                            }
                            <InputFile OnChange="HandleFileSelected" accept="image/*" style="position: absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;" />
                        </div>
                    </div>
                }

                <div style="display: flex; gap: 1.5rem; margin-top: 1rem; background: var(--bg-primary); padding: 0.75rem 1rem; border-radius: 0.5rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                        <input type="checkbox" @bind="newProduct.IsActive" /> المنتج نشط
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                        <input type="checkbox" @bind="newProduct.IsWeighable" /> صنف مباع بالميزان
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                        <input type="checkbox" @bind="newProduct.TrackExpiry" /> تتبع تاريخ الصلاحية
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-primary" @onclick="SaveProduct" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>@(showEditModal ? "تحديث المنتج" : "حفظ المنتج")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && productToDelete != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 440px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: var(--accent-red);">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> حذف المنتج
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 1rem;">هل أنت تأكد من رغبتك في حذف المنتج <strong style="color: var(--text-primary);">@productToDelete.NameAr</strong> (@productToDelete.Barcode)؟</p>
                <p style="font-size: 0.85rem; color: var(--text-muted);">لا يمكن التراجع عن هذا الإجراء بعد تنفيذه.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-danger" @onclick="ExecuteDeleteProduct" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-trash-can me-1"></i> <span>تأكيد الحذف</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Excel Import Modal -->
@if (showImportModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 680px; max-width: 95vw;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-file-excel me-2" style="color: #107c41;"></i> استيراد منتجات من ملف إكسيل
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(importErrorMessage))
                {
                    <div style="background: rgba(239, 68, 68, 0.15); border-right: 4px solid var(--accent-red); color: var(--accent-red); padding: 0.75rem 1rem; border-radius: 0.4rem; margin-bottom: 1rem; font-size: 0.9rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @importErrorMessage
                    </div>
                }

                <div style="margin-bottom: 1.25rem;">
                    <label class="form-label" style="font-weight: 600;">اختر ملف الإكسيل (.xlsx, .xls, .csv)</label>
                    <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xls,.csv" class="form-control" style="padding: 0.5rem;" />
                    @if (!string.IsNullOrEmpty(selectedImportFileName))
                    {
                        <div style="margin-top: 0.4rem; font-size: 0.85rem; color: var(--accent-emerald);">
                            <i class="fa-solid fa-file-circle-check me-1"></i> الملف المحدد: <strong>@selectedImportFileName</strong> (@(selectedImportFileBytes?.Length / 1024 ?? 0) KB)
                        </div>
                    }
                </div>

                <div style="background: rgba(255,255,255,0.03); padding: 0.85rem; border-radius: 0.5rem; border: 1px dashed rgba(255,255,255,0.1); margin-bottom: 1.25rem;">
                    <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.9rem; margin-bottom: 0.3rem; font-weight: 600;">
                        <input type="checkbox" @bind="updateExistingInImport" style="width: 1.1rem; height: 1.1rem;" />
                        تحديث بيانات المنتج إذا كان الباركود موجواً بالفعل في الكتالوج
                    </label>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; padding-right: 1.7rem;">
                        عند تفعيل هذا الخيار، سيتم تعديل أسعار واسم وتصنيف المنتج الموجود مسبقاً بنفس الباركود بدلاً من تخطيه.
                    </p>
                </div>

                @if (importResult != null)
                {
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                        <h4 style="font-size: 0.95rem; margin-bottom: 0.75rem; color: var(--text-primary);">ملخص نتيجة الاستيراد:</h4>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 1rem;">
                            <div style="background: rgba(255,255,255,0.05); padding: 0.75rem; border-radius: 0.5rem; text-align: center;">
                                <div style="font-size: 0.8rem; color: var(--text-muted);">إجمالي الصفوف</div>
                                <div style="font-size: 1.3rem; font-weight: 700;">@importResult.TotalRows</div>
                            </div>
                            <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.75rem; border-radius: 0.5rem; text-align: center;">
                                <div style="font-size: 0.8rem; color: var(--accent-emerald);">تم استيرادها بنجاح</div>
                                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-emerald);">@importResult.SuccessCount</div>
                            </div>
                            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.75rem; border-radius: 0.5rem; text-align: center;">
                                <div style="font-size: 0.8rem; color: var(--accent-red);">صفوف بها أخطاء</div>
                                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-red);">@importResult.ErrorCount</div>
                            </div>
                        </div>

                        @if (importResult.Errors != null && importResult.Errors.Any())
                        {
                            <h5 style="font-size: 0.85rem; color: var(--accent-red); margin-bottom: 0.5rem;">
                                <i class="fa-solid fa-list-check me-1"></i> قائمة الصفوف غير المستوردة وأسباب الخطأ:
                            </h5>
                            <div style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 0.4rem;">
                                <table class="data-table" style="font-size: 0.8rem;">
                                    <thead>
                                        <tr>
                                            <th>الصف</th>
                                            <th>الباركود</th>
                                            <th>الاسم</th>
                                            <th>سبب الخطأ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var err in importResult.Errors)
                                        {
                                            <tr>
                                                <td>#@err.RowNumber</td>
                                                <td><code>@err.Barcode</code></td>
                                                <td>@err.ProductName</td>
                                                <td style="color: var(--accent-red);">@err.ErrorMessage</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إغلاق</button>
                <button class="btn btn-primary" style="background: #107c41; border-color: #107c41;" @onclick="ExecuteImportExcel" disabled="@(isSaving || selectedImportFileBytes == null)">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الاستيراد...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-upload me-1"></i> <span>بدء الاستيراد الان</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto> products = new();
    private List<ProductDto> filtered = new();
    private List<CategoryDto> categories = new();
    private List<UnitDto> units = new();
    private List<SupplierDto> suppliers = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<ProductDto> PagedProducts => filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private string search = string.Empty;
    private string quickScanBarcode = string.Empty;
    private bool isFetchingOnline = false;
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool isSaving = false;
    private string errorMessage = string.Empty;

    private Guid editingProductId = Guid.Empty;
    private ProductDto? productToDelete;
    private string categoryIdString = string.Empty;
    private string unitIdString = string.Empty;
    private string supplierIdString = string.Empty;

    private byte[]? selectedImageBytes;
    private string? selectedFileName;
    private string? imagePreviewUrl;

    private CreateProductFormModel newProduct = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        products = await ApiClient.GetProductsAsync();
        categories = await ApiClient.GetCategoriesAsync();
        units = await ApiClient.GetUnitsAsync();
        suppliers = await ApiClient.GetSuppliersAsync();
        Filter();
    }

    private void Filter()
    {
        currentPage = 1;
        if (string.IsNullOrWhiteSpace(search))
        {
            filtered = products.ToList();
        }
        else
        {
            filtered = products.Where(p =>
                p.NameAr.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                p.NameEn.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                p.Barcode.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        EnsureValidPage();
    }

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filtered.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private async Task HandleQuickScanBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(quickScanBarcode))
        {
            var code = quickScanBarcode.Trim();
            quickScanBarcode = string.Empty;

            var existing = products.FirstOrDefault(p => string.Equals(p.Barcode, code, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                existing = await ApiClient.GetProductByBarcodeAsync(code);
            }

            if (existing is not null)
            {
                OpenEditModal(existing);
            }
            else
            {
                await OpenAddModalWithBarcodeAsync(code);
            }
        }
    }

    private async Task OpenAddModalWithBarcodeAsync(string barcode)
    {
        OpenAddModal();
        newProduct.Barcode = barcode;
        await FetchOnlineProductInfo();
    }

    private async Task FetchOnlineProductInfo()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Barcode))
        {
            errorMessage = "الرجاء أدخل أو امسح الباركود أولاً قبل البحث أونلاين.";
            return;
        }

        isFetchingOnline = true;
        errorMessage = string.Empty;

        var result = await ApiClient.LookupProductOnlineAsync(newProduct.Barcode);
        isFetchingOnline = false;

        if (result is not null)
        {
            if (!string.IsNullOrWhiteSpace(result.NameAr)) newProduct.NameAr = result.NameAr;
            if (!string.IsNullOrWhiteSpace(result.NameEn)) newProduct.NameEn = result.NameEn;

            if (result.ImageBytes is not null && result.ImageBytes.Length > 0)
            {
                selectedImageBytes = result.ImageBytes;
                selectedFileName = $"{newProduct.Barcode}_online.jpg";
                var base64 = Convert.ToBase64String(result.ImageBytes);
                imagePreviewUrl = $"data:image/jpeg;base64,{base64}";
            }
        }
        else
        {
            errorMessage = "لم يتوفر هذا الباركود في قاعدة البيانات العالمية المفتوحة. يمكنك أدخال اسم المنتج وسعر البيع يدوياً بسهولة.";
        }
    }

    private void OpenAddModal()
    {
        editingProductId = Guid.Empty;
        newProduct = new CreateProductFormModel();
        GenerateBarcode();
        categoryIdString = categories.FirstOrDefault()?.Id.ToString() ?? string.Empty;
        unitIdString = units.FirstOrDefault()?.Id.ToString() ?? string.Empty;
        supplierIdString = string.Empty;

        selectedImageBytes = null;
        selectedFileName = null;
        imagePreviewUrl = null;
        errorMessage = string.Empty;

        showAddModal = true;
        showEditModal = false;
    }

    private void OpenEditModal(ProductDto prod)
    {
        editingProductId = prod.Id;
        newProduct = new CreateProductFormModel
        {
            Barcode = prod.Barcode,
            NameAr = prod.NameAr,
            NameEn = prod.NameEn,
            Description = prod.Description,
            CategoryId = prod.CategoryId,
            UnitId = prod.UnitId,
            SupplierId = prod.SupplierId,
            PurchasePrice = prod.PurchasePrice,
            SellingPrice = prod.SellingPrice,
            WholesalePrice = prod.WholesalePrice,
            ReorderLevel = prod.ReorderLevel,
            MaxStockLevel = prod.MaxStockLevel,
            IsWeighable = prod.IsWeighable,
            IsActive = prod.IsActive,
            TrackExpiry = prod.TrackExpiry,
            TaxRate = prod.TaxRate
        };

        categoryIdString = prod.CategoryId.ToString();
        unitIdString = prod.UnitId.ToString();
        supplierIdString = prod.SupplierId?.ToString() ?? string.Empty;

        errorMessage = string.Empty;
        showEditModal = true;
        showAddModal = false;
    }

    private void ConfirmDeleteProduct(ProductDto prod)
    {
        productToDelete = prod;
        showDeleteModal = true;
    }

    private void CloseModals()
    {
        showAddModal = false;
        showEditModal = false;
        showDeleteModal = false;
        showImportModal = false;
        productToDelete = null;
    }

    private void GenerateBarcode()
    {
        newProduct.Barcode = $"{Random.Shared.Next(6290000, 6299999)}{Random.Shared.Next(10000, 99999)}";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            selectedFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            selectedImageBytes = ms.ToArray();

            var base64 = Convert.ToBase64String(selectedImageBytes);
            imagePreviewUrl = $"data:{file.ContentType};base64,{base64}";
        }
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Barcode))
        {
            errorMessage = "الرجاء إدخال أو توليد الباركود.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newProduct.NameAr))
        {
            errorMessage = "الرجاء إدخال اسم المنتج بالعربية.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newProduct.NameEn))
        {
            errorMessage = "الرجاء إدخال اسم المنتج بالإنجليزية.";
            return;
        }

        if (!Guid.TryParse(categoryIdString, out var categoryId) || categoryId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار تصنيف صحيح.";
            return;
        }

        if (!Guid.TryParse(unitIdString, out var unitId) || unitId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار وحدة صالحة.";
            return;
        }

        newProduct.CategoryId = categoryId;
        newProduct.UnitId = unitId;
        newProduct.SupplierId = Guid.TryParse(supplierIdString, out var supplierId) ? supplierId : null;

        isSaving = true;
        errorMessage = string.Empty;

        if (showEditModal)
        {
            var updateModel = new UpdateProductCommandModel(
                editingProductId,
                newProduct.Barcode,
                newProduct.NameAr,
                newProduct.NameEn,
                newProduct.Description,
                newProduct.CategoryId,
                newProduct.UnitId,
                newProduct.SupplierId,
                newProduct.PurchasePrice,
                newProduct.SellingPrice,
                newProduct.WholesalePrice,
                newProduct.ReorderLevel,
                newProduct.MaxStockLevel,
                newProduct.IsWeighable,
                newProduct.IsActive,
                newProduct.TrackExpiry,
                newProduct.TaxRate,
                null);

            var (success, error) = await ApiClient.UpdateProductAsync(updateModel);
            isSaving = false;

            if (success)
            {
                CloseModals();
                await LoadData();
            }
            else
            {
                errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل تحديث المنتج.";
            }
        }
        else
        {
            var (result, error) = await ApiClient.CreateProductAsync(newProduct, selectedImageBytes, selectedFileName);
            isSaving = false;

            if (result.HasValue && result.Value != Guid.Empty)
            {
                CloseModals();
                await LoadData();
            }
            else
            {
                errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل حفظ المنتج. الرجاء التحقق من مدخلاتك أو سجلات النظام.";
            }
        }
    }

    private async Task ExecuteDeleteProduct()
    {
        if (productToDelete == null) return;

        isSaving = true;
        var success = await ApiClient.DeleteProductAsync(productToDelete.Id);
        isSaving = false;

        if (success)
        {
            CloseModals();
            await LoadData();
        }
        else
        {
            errorMessage = "فشل حذف المنتج. يتطلب صلاحيات المدير.";
        }
    }

    private string GetImageFullUrl(string? relativeOrUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeOrUrl)) return string.Empty;
        if (relativeOrUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || relativeOrUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) return relativeOrUrl;
        return $"http://localhost:5000/{relativeOrUrl.TrimStart('/')}";
    }

    private bool showImportModal = false;
    private bool updateExistingInImport = false;
    private byte[]? selectedImportFileBytes;
    private string? selectedImportFileName;
    private string importErrorMessage = string.Empty;
    private ProductImportResultDto? importResult;

    private void OpenImportModal()
    {
        selectedImportFileBytes = null;
        selectedImportFileName = null;
        importErrorMessage = string.Empty;
        importResult = null;
        updateExistingInImport = false;
        showImportModal = true;
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        importErrorMessage = string.Empty;
        importResult = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                importErrorMessage = "حجم الملف يتجاوز الحد الأقصى المسموح به (10 ميجابايت).";
                return;
            }

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                selectedImportFileBytes = ms.ToArray();
                selectedImportFileName = file.Name;
            }
            catch (Exception ex)
            {
                importErrorMessage = $"خطأ في قراءة الملف: {ex.Message}";
            }
        }
    }

    private async Task ExecuteImportExcel()
    {
        if (selectedImportFileBytes == null || string.IsNullOrEmpty(selectedImportFileName))
        {
            importErrorMessage = "الرجاء اختيار ملف إكسيل أولاً.";
            return;
        }

        isSaving = true;
        importErrorMessage = string.Empty;
        importResult = null;

        var (res, err) = await ApiClient.ImportProductsExcelAsync(
            selectedImportFileBytes,
            selectedImportFileName,
            updateExistingInImport);

        isSaving = false;

        if (res != null)
        {
            importResult = res;
            await LoadData();
        }
        else
        {
            importErrorMessage = !string.IsNullOrEmpty(err) ? err : "فشل استيراد ملف الإكسيل.";
        }
    }

    private async Task DownloadExcelTemplate()
    {
        var bytes = await ApiClient.DownloadProductExcelTemplateAsync();
        if (bytes != null && bytes.Length > 0)
        {
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                "Products_Import_Template.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        else
        {
            errorMessage = "فشل تحميل قالب الإكسيل من السيرفر.";
        }
    }
}
