@page "/products"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@attribute [Authorize]
@inject PosApiClient ApiClient

<div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-weight: 700;">Products Inventory Catalog</h2>
        <button class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Product</button>
    </div>

    <div class="search-box mb-3" style="max-width: 400px; margin-bottom: 1rem;">
        <i class="fa-solid fa-search"></i>
        <input @bind="search" @bind:event="oninput" @onkeyup="Filter" placeholder="Filter products..." />
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Barcode</th>
                <th>Name (Ar)</th>
                <th>Name (En)</th>
                <th>Category</th>
                <th>Selling Price</th>
                <th>Stock</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in filtered)
            {
                <tr>
                    <td><code>@prod.Barcode</code></td>
                    <td style="font-weight: 600;">@prod.NameAr</td>
                    <td>@prod.NameEn</td>
                    <td>@prod.CategoryName</td>
                    <td style="color: var(--accent-green); font-weight: 700;">@prod.SellingPrice.ToString("N2") EGP</td>
                    <td>@prod.QuantityInStock.ToString("N0") @prod.UnitSymbol</td>
                    <td>
                        <span class="badge @(prod.IsActive ? "badge-green" : "badge-red")">
                            @(prod.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ProductDto> products = new();
    private List<ProductDto> filtered = new();
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        products = await ApiClient.GetProductsAsync();
        filtered = products;
    }

    private void Filter()
    {
        filtered = string.IsNullOrWhiteSpace(search) 
            ? products 
            : products.Where(p => p.NameAr.Contains(search, StringComparison.OrdinalIgnoreCase) || p.Barcode.Contains(search)).ToList();
    }
}
